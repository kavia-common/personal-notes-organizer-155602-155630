# Environment variables for notes_frontend (Angular)
# These values are not read directly by the app at runtime.
# The deployment pipeline should map them into src/assets/app-config.json.

# Base URL of the backend API, e.g., https://api.example.com
FRONTEND_API_BASE_URL=http://localhost:8000

# Public site URL used for redirects (if needed)
FRONTEND_SITE_URL=http://localhost:3000
